    </collision>
    <inertial>
      <!-- Solid cylinder, axis along X (collision rpy="0 1.57 0"), r=0.03, L=0.0545, m=0.95
           Ixx = m*r^2/2 = 0.95*0.0009/2 = 0.000428
           Iyy = Izz = m*(3r^2+L^2)/12 = 0.95*(0.0027+0.002970)/12 = 0.000449 -->
      <origin rpy="0 0 0" xyz="-0.02725 0 0" />
      <mass value="0.95" />
      <inertia ixx="0.000428" ixy="0" ixz="0" iyy="0.000449" iyz="0" izz="0.000449" />
    </inertial>
  </link>

  <joint name="ankle_R_Joint" type="revolute">
    <origin rpy="0 0 0" xyz="-0.025 0 -0.025" />
