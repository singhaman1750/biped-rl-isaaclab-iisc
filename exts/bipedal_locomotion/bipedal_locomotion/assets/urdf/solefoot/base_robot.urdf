    <collision>
      <origin xyz="0.01 0 -0.035" rpy="0 0 0" />
      <geometry>
        <box size="0.2 0.07 0.03" />
      </geometry>
    </collision>
    <inertial>
      <!-- Box 0.2(x)*0.07(y)*0.03(z), m=0.62, CoM at box center
           Ixx = m*(b^2+c^2)/12 = 0.62*(0.0049+0.0009)/12 = 0.000300
           Iyy = m*(a^2+c^2)/12 = 0.62*(0.04+0.0009)/12 = 0.002113
           Izz = m*(a^2+b^2)/12 = 0.62*(0.04+0.0049)/12 = 0.002320 -->
