<?xml version="1.0" encoding="utf-8"?>
<robot name="SF_TRON1">

  <material name="black">
    <color rgba="0.0 0.0 0.0 1.0" />
  </material>
  <material name="blue">
    <color rgba="0.0 0.0 0.8 1.0" />
  </material>
  <material name="green">
    <color rgba="0.0 0.8 0.0 1.0" />
  </material>
  <material name="grey">
    <color rgba="0.2 0.2 0.2 1.0" />
  </material>
  <material name="silver">
    <color rgba="0.913725490196 0.913725490196 0.847058823529 1.0" />
  </material>
  <material name="orange">
    <color rgba="1.0 0.423529411765 0.0392156862745 1.0" />
  </material>
  <material name="brown">
    <color rgba="0.870588235294 0.811764705882 0.764705882353 1.0" />
  </material>
  <material name="red">
    <color rgba="0.8 0.0 0.0 1.0" />
  </material>
  <material name="white">
    <color rgba="1.0 1.0 1.0 1.0" />
  </material>

  <!-- ==================== BASE ==================== -->

  <link name="base_Link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.27 0.26 0.19" />
      </geometry>
      <material name="">
        <color rgba="0.79216 0.81961 0.93333 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.27 0.26 0.19" />
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <mass value="5" />
      <inertia ixx="0.043208" ixy="0" ixz="0" iyy="0.045417" iyz="0" izz="0.058542" />
    </inertial>
  </link>

  <!-- ==================== IMU ==================== -->

  <joint name="limx_imu_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0" />
    <parent link="base_Link" />
    <child link="limx_imu" />
  </joint>

  <link name="limx_imu">
    <inertial>
      <mass value="0.01" />
      <origin rpy="0 0 0" xyz="0 0 0" />
      <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001" />
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <box size="0.015 0.015 0.004" />
      </geometry>
      <material name="orange" />
    </visual>
  </link>

  <!-- ==================== RIGHT LEG ==================== -->

  <!--
    abad_R_fixed_joint origin is derived so the effective position of the
    revolute abad_R_Joint in base_Link frame matches the original Tron1 URDF:
      xyz = (0.05556, -0.105, -0.2602) = fixed_xyz + (-0.0545, 0, 0)
      => fixed_xyz = (0.11006, -0.10500, -0.26020)
  -->
  <joint name="abad_R_fixed_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0.08865 -0.0817 -0.1875" />
    <parent link="base_Link" />
    <child link="abad_R_actuator_Link" />
  </joint>

  <link name="abad_R_actuator_Link">
    <visual>
      <origin rpy="0 1.57079632679 0" xyz="-0.02725 0 0" />
      <geometry>
        <cylinder length="0.0545" radius="0.0483" />
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 1.57079632679 0" xyz="-0.02725 0 0" />
      <geometry>
        <cylinder length="0.0545" radius="0.0483" />
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="-0.02725 0 0" />
      <mass value="0.95" />
      <inertia ixx="0.001108" ixy="0" ixz="0" iyy="0.000789" iyz="0" izz="0.000789" />
    </inertial>
  </link>

  <!-- Revolute joint at (-0.0545,0,0) relative to actuator; effective position from base_Link = (0.05556,-0.105,-0.2602) -->
  <joint name="abad_R_Joint" type="revolute">
    <origin rpy="0 0 0" xyz="-0.0545 0 0" />
    <parent link="abad_R_actuator_Link" />
    <child link="abad_R_Link" />
    <axis xyz="-1 0 0" />
    <dynamics damping="0" friction="0" />
    <limit effort="80.0" lower="-0.38397" upper="1.39626" velocity="15.0" />
  </joint>

  <link name="abad_R_Link">
    <visual>
      <origin rpy="1.57079632679 0 0" xyz="-0.0683 0.035 0" />
      <geometry>
        <cylinder length="0.0545" radius="0.0483" />
      </geometry>
    </visual>
    <collision>
      <origin rpy="1.57079632679 0 0" xyz="-0.0683 0.035 0" />
      <geometry>
        <cylinder length="0.0545" radius="0.0483" />
      </geometry>
    </collision>
    <inertial>
      <!-- Solid cylinder, axis along Y (rpy="1.57 0 0"), r=0.0483, L=0.0545, m=1.469
           Iyy = m*r^2/2 = 1.469*0.0483^2/2 = 0.001713
           Ixx = Izz = m*(3r^2+L^2)/12 = 1.469*(3*0.002333+0.002970)/12 = 0.001220 -->
      <origin rpy="0 0 0" xyz="-0.0683 0.035 0" />
      <mass value="1.469" />
      <inertia ixx="0.001220" ixy="0" ixz="0"
               iyy="0.001713" iyz="0" izz="0.001220" />
    </inertial>
  </link>

  <joint name="hip_R_Joint" type="revolute">
    <origin rpy="0 0 0" xyz="-0.0683 0.03050 0" />
    <parent link="abad_R_Link" />
    <child link="hip_R_Link" />
    <axis xyz="0 -1 0" />
    <dynamics damping="0" friction="0" />
    <limit effort="80.0" lower="-1.396263" upper="1.012291" velocity="15.0" />
  </joint>

  <link name="hip_R_Link">
    <visual>
      <origin rpy="1.57079632679 0 0" xyz="0 -0.08275 0" />
      <geometry>
        <cylinder length="0.0545" radius="0.0483" />
      </geometry>
    </visual>
    <collision>
      <origin rpy="1.57079632679 0 0" xyz="0 -0.08275 0" />
      <geometry>
        <cylinder length="0.0545" radius="0.0483" />
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 -0.08275 0" />
      <mass value="0.95" />
      <inertia ixx="0.000789" ixy="0" ixz="0" iyy="0.001108" iyz="0" izz="0.000789" />
    </inertial>
  </link>

  <joint name="hip_R_fixed_joint" type="fixed">
    <origin rpy="0 0.610865 0" xyz="0 -0.08275 0" />
    <parent link="hip_R_Link" />
    <child link="hip_R_thigh_Link" />
  </joint>

  <link name="hip_R_thigh_Link">
    <visual>
      <origin rpy="1.57079632679 0 0" xyz="0 0.04325 0" />
      <geometry>
        <cylinder length="0.032" radius="0.0483" />
      </geometry>
    </visual>
    <visual>
      <origin rpy="0 0 0" xyz="0 0.04325 -0.175" />
      <geometry>
        <box size="0.05 0.032 0.25" />
      </geometry>
    </visual>
    <collision>
      <origin rpy="1.57079632679 0 0" xyz="0 0.04325 0" />
      <geometry>
        <cylinder length="0.032" radius="0.0483" />
      </geometry>
    </collision>
    <collision>
      <origin rpy="0 0 0" xyz="0 0.04325 -0.175" />
      <geometry>
        <box size="0.05 0.032 0.25" />
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0.04325 -0.175" />
      <mass value="1.5" />
      <inertia ixx="0.011378" ixy="0" ixz="0" iyy="0.011562" iyz="0" izz="0.000441" />
    </inertial>
  </link>

  <!--
    knee_R_Joint origin relative to hip_R_thigh_Link is derived so the effective
    position from hip_R_Link matches the original Tron1 URDF xyz=(-0.1500,0.02050,-0.25981):
      hip_R_fixed_joint: (0,-0.08275,0) + knee_R_Joint: (-0.15000,0.10325,-0.25981) = (-0.15000,0.02050,-0.25981)
  -->
  <joint name="knee_R_Joint" type="revolute">
    <origin rpy="0 -1.3090 0" xyz="0 0.04325 -0.35" />
    <parent link="hip_R_thigh_Link" />
    <child link="knee_R_Link" />
    <axis xyz="0 -1 0" />
    <dynamics damping="0" friction="0" />
    <limit effort="80" lower="-1.21357" upper="1.172665" velocity="15" />
  </joint>

  <link name="knee_R_Link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 -0.15" />
      <geometry>
        <box size="0.025 0.032 0.3" />
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 -0.15" />
      <geometry>
        <box size="0.025 0.032 0.3" />
      </geometry>
    </collision>
    <inertial>
      <!-- Box 0.025(x)*0.032(y)*0.3(z), m=1.22, CoM at box center
           Ixx = m*(b^2+c^2)/12 = 1.22*(0.001024+0.09)/12 = 0.009254
           Iyy = m*(a^2+c^2)/12 = 1.22*(0.000625+0.09)/12 = 0.009214
           Izz = m*(a^2+b^2)/12 = 1.22*(0.000625+0.001024)/12 = 0.000168 -->
      <origin rpy="0 0 0" xyz="0 0 -0.15" />
      <mass value="1.22" />
      <inertia ixx="0.009254" ixy="0" ixz="0"
               iyy="0.009214" iyz="0" izz="0.000168" />
    </inertial>
  </link>

  <joint name="ankle_R_actuator_Joint" type="fixed">
    <origin rpy="0 0.6982 0" xyz="0.018 0 -0.34" />
    <parent link="knee_R_Link" />
    <child link="ankle_R_actuator_Link" />
  </joint>

  <link name="ankle_R_actuator_Link">
    <visual>
