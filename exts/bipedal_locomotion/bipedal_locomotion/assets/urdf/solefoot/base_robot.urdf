           Iyy = m*(a^2+c^2)/12 = 0.62*(0.04+0.0009)/12 = 0.002113
           Izz = m*(a^2+b^2)/12 = 0.62*(0.04+0.0049)/12 = 0.002320 -->
      <origin rpy="0 0 0" xyz="0.01 0 -0.035" />
      <mass value="0.62" />
      <inertia ixx="0.000300" ixy="0" ixz="0"
               iyy="0.002113" iyz="0" izz="0.002320" />
    </inertial>
  </link>

</robot>
