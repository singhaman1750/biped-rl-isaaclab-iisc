      <geometry>
        <box size="0.27 0.26 0.19"/>
      </geometry>
    </collision>
  </link>

  <!-- ============================================================
       IMU (fixed joint – dont_collapse preserves prim in USD tree)
       ============================================================ -->
  <joint name="limx_imu_joint" type="fixed">
    <origin xyz="0. 0. 0." rpy="0. 0. 0."/>
    <parent link="base_Link"/>
    <child link="limx_imu"/>
